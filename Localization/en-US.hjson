Mods: {
	RobotJack: {
		Items: {
			RobotTrigger: {
				DisplayName: Robot Trigger
				Tooltip:
					'''
					Use to transform into Robot Jack; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed
					Higher jumps, no knockback or fall damage, hold jump to hover down
					While transformed you get ability items
					"Some assembly required."
					'''
			}

			OrbitalCannonStrike: {
				DisplayName: Orbital Cannon Strike
				Tooltip:
					'''
					Click anywhere on screen to call down a massive laser from a satellite in orbit
					The satellite needs a moment to lock on before it fires
					8 second cooldown
					'''
			}

			PlasmaCannon: {
				DisplayName: Plasma Cannon
				Tooltip: Rapid-fire plasma bolts from your arm cannon
			}

			MissileBarrage: {
				DisplayName: Missile Barrage
				Tooltip: Launches a volley of homing micro-missiles that explode on impact
			}

			ThrusterDash: {
				DisplayName: Thruster Dash
				Tooltip: Rocket toward the cursor, burning everything in your path
			}

			EnergyAbsorber: {
				DisplayName: Energy Absorber
				Tooltip:
					'''
					Hold left click to open an absorb field:
					  every attack that hits you is neutralised and stored as energy
					  enemy projectiles and nearby enemies are pulled in
					  anything close enough is drained, giving you more energy
					Right click to release a blast dealing 10x your stored energy to everything nearby,
					and fire back every attack you absorbed at 10x its damage
					'''
			}

			GravityArm: {
				DisplayName: Gravity Arm
				Tooltip:
					'''
					Hold left click to open a gravity well at your cursor
					Enemies near it are pulled toward the cursor and held there
					Bosses are too heavy to move
					'''
			}

			TitanSpeakerCore: {
				DisplayName: Titan Speaker Core
				Tooltip:
					'''
					Use to transform into Titan Speaker; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life
					Titans are twice as big, hitbox included
					While transformed you get the Titan's own ability items
					"Turn it up."
					'''
			}

			TitanCameraCore: {
				DisplayName: Titan Camera Core
				Tooltip:
					'''
					Use to transform into Titan Camera; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life, +{5}% crit chance
					Titans are twice as big, hitbox included
					While transformed you get the Titan's own ability items
					"Say cheese."
					'''
			}

			TitanTVCore: {
				DisplayName: Titan TV Core
				Tooltip:
					'''
					Use to transform into Titan TV; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life
					Titans are twice as big, hitbox included
					While transformed you get the Titan's own ability items
					"Stay tuned."
					'''
			}

			SonicBoom: {
				DisplayName: Sonic Boom
				Tooltip:
					'''
					Fire a huge sound wave that passes through everything
					Heavy knockback
					'''
			}

			BassDrop: {
				DisplayName: Bass Drop
				Tooltip:
					'''
					Blast a ring of bass all around you
					Throws enemies away and confuses them
					'''
			}

			SpeakerBarrage: {
				DisplayName: Speaker Barrage
				Tooltip: Rapid-fire small sound waves
			}

			CoreLaser: {
				DisplayName: Core Laser
				Tooltip:
					'''
					Hold left click to fire a continuous laser from your chest core
					The beam turns to follow the cursor and stops at blocks
					'''
			}

			CameraFlash: {
				DisplayName: Camera Flash
				Tooltip:
					'''
					A blinding flash that damages and confuses everything nearby
					Stuns enemies in place for 2.5 seconds (not bosses)
					'''
			}

			LensBurst: {
				DisplayName: Lens Burst
				Tooltip: Fire three homing energy orbs from your lens
			}

			HypnoScreen: {
				DisplayName: Hypno Screen
				Tooltip:
					'''
					Beam three hypnotic waves from your screen
					Confuses enemies and stuns them briefly (not bosses)
					'''
			}

			EnergyBlades: {
				DisplayName: Energy Blades
				Tooltip: Swing a giant energy blade in a wide arc
			}

			StaticStorm: {
				DisplayName: Static Storm
				Tooltip: Spray six homing static orbs
			}

			RobotJetpack: {
				DisplayName: Robot Jetpack
				Tooltip:
					'''
					Allows flight
					While transformed into Robot Jack, flying into things head-first rams them:
					damage, heavy knockback, and they spin until the knockback wears off
					'''
			}
		}

		Buffs: {
			RobotForm: {
				DisplayName: Robot Jack
				Description: You are a combat robot
			}

			TitanSpeakerForm: {
				DisplayName: Titan Speaker
				Description: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life
			}

			TitanCameraForm: {
				DisplayName: Titan Camera
				Description: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life, +{5}% crit chance
			}

			TitanTVForm: {
				DisplayName: Titan TV
				Description: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life
			}

			Stunned: {
				DisplayName: Stunned
				Description: Frozen in place
			}

			OrbitalCannonCooldown: {
				DisplayName: Satellite Recharging
				Description: You can't call another Orbital Cannon Strike yet
			}

			Spinning: {
				DisplayName: Spinning
				Description: You got rammed by a robot
			}
		}

		Projectiles: {
			OrbitalStrike.DisplayName: Orbital Strike
			PlasmaBolt.DisplayName: Plasma Bolt
			HomingMissile.DisplayName: Micro-Missile
			ThrusterHitbox.DisplayName: Thruster Flames
			HeadRam.DisplayName: Robot Head
			AbsorbField.DisplayName: Absorb Field
			EnergyBlast.DisplayName: Energy Release
			EnergyEcho.DisplayName: Absorbed Attack
			GravityWell.DisplayName: Gravity Well
			SoundWave.DisplayName: Sound Wave
			SpeakerShockwave.DisplayName: Bass Drop
			CoreLaserBeam.DisplayName: Core Laser
			CameraFlashBurst.DisplayName: Camera Flash
			EnergyOrb.DisplayName: Energy Orb
			BladeSwing.DisplayName: Energy Blade
		}

		DropConditions: {
			Underground: Dropped by enemies underground
		}
	}
}
