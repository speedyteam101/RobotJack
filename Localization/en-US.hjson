Mods: {
	RobotJack: {
		Items: {
			RobotTrigger: {
				DisplayName: Robot Trigger
				Tooltip:
					'''
					Use to transform into Robot Jack; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed
					Higher jumps, no knockback or fall damage, hold jump to hover down
					While transformed you get ability items
					"Some assembly required."
					'''
			}

			OrbitalCannonStrike: {
				DisplayName: Orbital Cannon Strike
				Tooltip:
					'''
					Click anywhere on screen to call down a massive laser from a satellite in orbit
					The satellite needs a moment to lock on before it fires
					8 second cooldown
					'''
			}

			PlasmaCannon: {
				DisplayName: Plasma Cannon
				Tooltip: Rapid-fire plasma bolts from your arm cannon
			}

			MissileBarrage: {
				DisplayName: Missile Barrage
				Tooltip: Launches a volley of homing micro-missiles that explode on impact
			}

			ThrusterDash: {
				DisplayName: Thruster Dash
				Tooltip: Rocket toward the cursor, burning everything in your path
			}

			EnergyAbsorber: {
				DisplayName: Energy Absorber
				Tooltip:
					'''
					Hold left click to open an absorb field:
					  every attack that hits you is neutralised and stored as energy
					  enemy projectiles and nearby enemies are pulled in
					  anything close enough is drained, giving you more energy
					Right click to release a blast dealing 10x your stored energy to everything nearby,
					and fire back every attack you absorbed at 10x its damage
					'''
			}

			GravityArm: {
				DisplayName: Gravity Arm
				Tooltip:
					'''
					Hold left click to open a gravity well at your cursor
					Enemies near it are pulled toward the cursor and held there
					Bosses are too heavy to move
					'''
			}

			TitanSpeakerCore: {
				DisplayName: Titan Speaker Core
				Tooltip:
					'''
					Use to transform into Titan Speaker; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life
					Titans are twice as big, hitbox included
					While transformed you get the Titan's own ability items
					"Turn it up."
					'''
			}

			TitanCameraCore: {
				DisplayName: Titan Camera Core
				Tooltip:
					'''
					Use to transform into Titan Camera; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life, +{5}% crit chance
					Titans are twice as big, hitbox included
					While transformed you get the Titan's own ability items
					"Say cheese."
					'''
			}

			TitanTVCore: {
				DisplayName: Titan TV Core
				Tooltip:
					'''
					Use to transform into Titan TV; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life
					Titans are twice as big, hitbox included
					While transformed you get the Titan's own ability items
					"Stay tuned."
					'''
			}

			SonicBoom: {
				DisplayName: Sonic Boom
				Tooltip:
					'''
					Fire a huge sound wave that passes through everything
					Heavy knockback
					'''
			}

			BassDrop: {
				DisplayName: Bass Drop
				Tooltip:
					'''
					Blast a ring of bass all around you
					Throws enemies away and confuses them
					'''
			}

			SpeakerBarrage: {
				DisplayName: Speaker Barrage
				Tooltip: Rapid-fire small sound waves
			}

			CoreLaser: {
				DisplayName: Core Laser
				Tooltip:
					'''
					Hold left click to fire a continuous laser from your chest core
					The beam turns to follow the cursor and stops at blocks
					'''
			}

			CameraFlash: {
				DisplayName: Camera Flash
				Tooltip:
					'''
					A blinding flash that damages and confuses everything nearby
					Stuns enemies in place for 2.5 seconds (not bosses)
					'''
			}

			LensBurst: {
				DisplayName: Lens Burst
				Tooltip: Fire three homing energy orbs from your lens
			}

			HypnoScreen: {
				DisplayName: Hypno Screen
				Tooltip:
					'''
					Beam three hypnotic waves from your screen
					Confuses enemies and stuns them briefly (not bosses)
					'''
			}

			EnergyBlades: {
				DisplayName: Energy Blades
				Tooltip: Swing a giant energy blade in a wide arc
			}

			StaticStorm: {
				DisplayName: Static Storm
				Tooltip: Spray six homing static orbs
			}

			SpeakerArmy: {
				DisplayName: Speaker Army
				Tooltip:
					'''
					Summon an army of six speaker soldiers for 20 seconds
					They march along the ground, chase down enemies and shoot at them
					'''
			}

			SonicShieldAbility: {
				DisplayName: Sonic Shield
				Tooltip:
					'''
					Surround yourself with a bubble of sound for 6 seconds
					Shatters enemy projectiles, pushes enemies out and hurts them
					'''
			}

			SubwooferQuake: {
				DisplayName: Subwoofer Quake
				Tooltip: Stomp the ground: two giant sound waves roll out, one each way
			}

			FeedbackLoop: {
				DisplayName: Feedback Loop
				Tooltip: Twelve sound waves burst out in every direction
			}

			BoomDash: {
				DisplayName: Boom Dash
				Tooltip:
					'''
					Blast toward the cursor on a burst of bass
					Confuses everything you plough through
					'''
			}

			CameraArmy: {
				DisplayName: Camera Army
				Tooltip:
					'''
					Summon an army of six camera soldiers for 20 seconds
					They march along the ground, chase down enemies and shoot at them
					'''
			}

			TargetLock: {
				DisplayName: Target Lock
				Tooltip:
					'''
					Lock on to every enemy near the cursor
					Locked-on enemies take 50% more damage for 8 seconds
					'''
			}

			ZoomShot: {
				DisplayName: Zoom Shot
				Tooltip: A powerful shot from your zoom lens that pierces up to 6 enemies
			}

			Rewind: {
				DisplayName: Rewind
				Tooltip:
					'''
					Jump back to where you were 3 seconds ago
					Also restores the health you had then, if it was more
					'''
			}

			FlashGrenades: {
				DisplayName: Flash Grenades
				Tooltip:
					'''
					Throw three flash grenades that pop into small camera flashes
					The flashes confuse and briefly stun enemies (not bosses)
					'''
			}

			TVArmy: {
				DisplayName: TV Army
				Tooltip:
					'''
					Summon an army of six TV soldiers for 20 seconds
					They march along the ground, chase down enemies and shoot at them
					'''
			}

			ChannelSurf: {
				DisplayName: Channel Surf
				Tooltip:
					'''
					Teleport to the cursor, if there's room
					Bursts static orbs out where you leave and where you arrive
					'''
			}

			BladeDash: {
				DisplayName: Blade Dash
				Tooltip: Dash toward the cursor with an energy blade swing leading the way
			}

			StaticFieldAbility: {
				DisplayName: Static Field
				Tooltip:
					'''
					A crackling field surrounds you for 8 seconds
					Zaps every enemy inside it with lightning
					'''
			}

			BroadcastBeam: {
				DisplayName: Broadcast Beam
				Tooltip:
					'''
					Hold left click to broadcast a purple beam from your screen
					The beam turns to follow the cursor and stops at blocks
					'''
			}

			BlazeTrigger: {
				DisplayName: Blaze Trigger
				Tooltip:
					'''
					Use to transform into Blaze Jack; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed
					Immune to burning and lava; walk safely on hot blocks
					While transformed you get Blaze Jack's eight ability items
					Crafted from a Robot Trigger, which you keep
					"Fire it up."
					'''
			}

			FrostTrigger: {
				DisplayName: Frost Trigger
				Tooltip:
					'''
					Use to transform into Frost Jack; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed
					Immune to cold; no slipping on ice
					While transformed you get Frost Jack's eight ability items
					Crafted from a Robot Trigger, which you keep
					"Chill out."
					'''
			}

			VoltTrigger: {
				DisplayName: Volt Trigger
				Tooltip:
					'''
					Use to transform into Volt Jack; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed
					Much faster, +10% attack speed, immune to Electrified
					While transformed you get Volt Jack's eight ability items
					Crafted from a Robot Trigger, which you keep
					"Fully charged."
					'''
			}

			ShadowTrigger: {
				DisplayName: Shadow Trigger
				Tooltip:
					'''
					Use to transform into Shadow Jack; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{5}% crit chance
					Chance to dodge attacks, immune to Shadowflame
					While transformed you get Shadow Jack's eight ability items
					Crafted from a Robot Trigger, which you keep
					"Step into the dark."
					'''
			}

			NovaTrigger: {
				DisplayName: Nova Trigger
				Tooltip:
					'''
					Use to transform into Nova Jack; use again to turn back
					Form: +{0}% damage, +{1} defense, {2}% damage reduction, +{3}% movement speed, +{4} max life, +{5}% crit chance
					+5 health per second
					While transformed you get Nova Jack's eight ability items
					Crafted from a Robot Trigger, which you keep
					"Born from a dying star."
					'''
			}

			FlameBlaster: {
				DisplayName: Flame Blaster
				Tooltip: Rapid fireballs that burst into small explosions
			}

			InfernoBeam: {
				DisplayName: Inferno Beam
				Tooltip: Hold left click: a roaring stream of fire from your arm cannon
			}

			Eruption: {
				DisplayName: Eruption
				Tooltip: Five fire geysers burst out of the ground across the cursor
			}

			MeteorShower: {
				DisplayName: Meteor Shower
				Tooltip: Call down seven meteors that explode where they land
			}

			HeatNova: {
				DisplayName: Heat Nova
				Tooltip: A wave of heat bursts out around you
			}

			BlazeDash: {
				DisplayName: Blaze Dash
				Tooltip: Rocket toward the cursor in a trail of fire
			}

			FlameRing: {
				DisplayName: Flame Ring
				Tooltip: Five fireballs circle you for 10 seconds
			}

			OverheatBoost: {
				DisplayName: Overheat
				Tooltip: Overheat for 10 seconds: +30% damage and every hit sets enemies ablaze
			}

			IceShards: {
				DisplayName: Ice Shards
				Tooltip: Fire three piercing ice shards
			}

			FreezeRay: {
				DisplayName: Freeze Ray
				Tooltip: Hold left click: a freezing beam from your arm cannon
			}

			GlacierSpikes: {
				DisplayName: Glacier Spikes
				Tooltip: Five ice spires burst out of the ground across the cursor, freezing enemies
			}

			Hailstorm: {
				DisplayName: Hailstorm
				Tooltip: A storm of hail pelts the area around the cursor
			}

			Blizzard: {
				DisplayName: Blizzard
				Tooltip: A blizzard swirls around you for 8 seconds, freezing enemies inside
			}

			FrostNova: {
				DisplayName: Frost Nova
				Tooltip: A burst of cold around you that freezes enemies in place (not bosses)
			}

			IceOrbit: {
				DisplayName: Ice Orbit
				Tooltip: Four ice shards circle you for 10 seconds
			}

			CryoArmorBoost: {
				DisplayName: Cryo Armor
				Tooltip: Cryo Armor for 10 seconds: +25 defense and 20% damage reduction
			}

			ArcPistol: {
				DisplayName: Arc Pistol
				Tooltip: Very fast piercing electric bolts
			}

			LightningBeam: {
				DisplayName: Lightning Beam
				Tooltip: Hold left click: a crackling lightning beam from your arm cannon
			}

			ThunderStrike: {
				DisplayName: Thunder Strike
				Tooltip: Three lightning bolts strike the ground across the cursor
			}

			StormCall: {
				DisplayName: Storm Call
				Tooltip: Call a storm of electric bolts down onto the cursor
			}

			TeslaField: {
				DisplayName: Tesla Field
				Tooltip: A tesla field surrounds you for 8 seconds, shocking enemies inside
			}

			StaticDischarge: {
				DisplayName: Static Discharge
				Tooltip: Discharge a burst of static around you
			}

			VoltDash: {
				DisplayName: Volt Dash
				Tooltip: Zip toward the cursor at lightning speed
			}

			OverchargeBoost: {
				DisplayName: Overcharge
				Tooltip: Overcharge for 10 seconds: +40% movement speed and +25% attack speed
			}

			ShadowOrbs: {
				DisplayName: Shadow Orbs
				Tooltip: Four homing shadow orbs
			}

			VoidBeam: {
				DisplayName: Void Beam
				Tooltip: Hold left click: a beam of pure void from your arm cannon
			}

			ShadowSpikes: {
				DisplayName: Shadow Spikes
				Tooltip: Five shadow tendrils burst out of the ground across the cursor
			}

			DarkRain: {
				DisplayName: Dark Rain
				Tooltip: Dark orbs rain down onto the cursor
			}

			VoidPulse: {
				DisplayName: Void Pulse
				Tooltip: A pulse of void energy bursts out around you
			}

			ShadowStep: {
				DisplayName: Shadow Step
				Tooltip: Step through the shadows toward the cursor, invincible for longer
			}

			PhantomBlades: {
				DisplayName: Phantom Blades
				Tooltip: Six phantom blades circle you for 10 seconds
			}

			VampiricShroudBoost: {
				DisplayName: Vampiric Shroud
				Tooltip: Vampiric Shroud for 10 seconds: your hits steal life
			}

			StarShot: {
				DisplayName: Star Shot
				Tooltip: Five homing stars
			}

			SupernovaBeam: {
				DisplayName: Supernova Beam
				Tooltip: Hold left click: a blazing starlight beam from your arm cannon
			}

			CometPillars: {
				DisplayName: Comet Pillars
				Tooltip: Seven pillars of starlight burst out of the ground across the cursor
			}

			Starfall: {
				DisplayName: Starfall
				Tooltip: Call down falling stars that explode where they land
			}

			BigBang: {
				DisplayName: Big Bang
				Tooltip: A colossal explosion of starlight around you
			}

			CometDash: {
				DisplayName: Comet Dash
				Tooltip: Streak toward the cursor like a comet
			}

			Constellation: {
				DisplayName: Constellation
				Tooltip: Eight stars circle you for 10 seconds
			}

			CelestialBlessingBoost: {
				DisplayName: Celestial Blessing
				Tooltip: Celestial Blessing for 10 seconds: +10 health per second and +15% damage
			}

			RobotJetpack: {
				DisplayName: Robot Jetpack
				Tooltip:
					'''
					Allows flight
					While transformed into Robot Jack, flying into things head-first rams them:
					damage, heavy knockback, and they spin until the knockback wears off
					'''
			}
		}

